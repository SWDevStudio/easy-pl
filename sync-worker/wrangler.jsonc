{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easy-pl-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "easy-pl-sync",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
